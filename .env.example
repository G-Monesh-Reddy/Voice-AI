# ==============================================================================
# HOME CREDIT LAP VOICE AGENT - ENVIRONMENT CONFIGURATION (GEMINI POWERED)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Mandatory LLM Provider: Google Gemini API (using official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Voice Platform Integrations (Fill if deploying to live platforms)
# Retell AI Credentials (https://www.retellai.com)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here

# Bolna Credentials (https://www.bolna.dev)
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Agent Default Settings
DEFAULT_AGENT_NAME=Pooja
DEFAULT_AGENT_GENDER=female
DEFAULT_LANGUAGE=English
COMPANY_NAME=Home Credit
MAX_LOAN_AMOUNT=7500000
MIN_TENURE_YEARS=3
MAX_TENURE_YEARS=15
